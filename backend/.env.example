NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=db_credi_dev

# Origens exatas, separadas por vírgula; HTTPS obrigatório em produção.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
AUTH_SESSION_SECONDS=28800
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=50
AUTH_LOGIN_ACCOUNT_LIMIT=10
# Mantenha 0 localmente. Ajuste somente conforme a topologia real do proxy.
TRUST_PROXY_HOPS=0
