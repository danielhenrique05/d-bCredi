# URL pública da nova API independente. A camada ainda não é usada pelo site ativo.
# Configure somente no ambiente apropriado, preservando suas variáveis existentes.
# Desenvolvimento: VITE_DNB_API_BASE_URL=http://127.0.0.1:3000
# Produção: VITE_DNB_API_BASE_URL=https://api.seu-dominio.example
# Deixe vazio enquanto a nova camada não for utilizada. Não coloque segredos aqui.
VITE_DNB_API_BASE_URL=
